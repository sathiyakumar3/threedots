rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    // Use resource.data directly (avoids get() on the same doc being evaluated)
    function isAdminOf(boardData) {
      return isAuthed()
        && 'users' in boardData
        && 'admins' in boardData.users
        && request.auth.uid in boardData.users.admins;
    }

    function isMemberOf(boardData) {
      return isAuthed()
        && 'users' in boardData
        && (
          ('admins'  in boardData.users && request.auth.uid in boardData.users.admins)  ||
          ('members' in boardData.users && request.auth.uid in boardData.users.members)
        );
    }

    // Use get() only for subcollections (looking up a *different* document)
    function isBoardMember(boardId) {
      let boardData = get(/databases/$(database)/documents/boards/$(boardId)).data;
      return isMemberOf(boardData);
    }

    function isBoardAdmin(boardId) {
      let boardData = get(/databases/$(database)/documents/boards/$(boardId)).data;
      return isAdminOf(boardData);
    }

    // Caller may accept only their own pending email invitation.
    function canAcceptOwnInvite(boardData, nextBoardData) {
      return isAuthed()
        && request.auth.token.email != null
        && 'users' in boardData
        && 'members' in boardData.users
        && 'nonMembers' in boardData.users
        && 'users' in nextBoardData
        && 'members' in nextBoardData.users
        && 'nonMembers' in nextBoardData.users
        && request.auth.token.email in boardData.users.nonMembers
        && !(request.auth.token.email in nextBoardData.users.nonMembers)
        && request.auth.uid in nextBoardData.users.members
        && !(request.auth.uid in boardData.users.members)
        && nextBoardData.users.members.hasAll(boardData.users.members)
        && nextBoardData.users.members.size() == boardData.users.members.size() + 1
        && boardData.users.nonMembers.hasAll(nextBoardData.users.nonMembers)
        && nextBoardData.users.nonMembers.size() == boardData.users.nonMembers.size() - 1;
    }

    // ── Users collection ──────────────────────────────────────────────────
    match /users/{uid} {
      allow read:  if isAuthed();
      allow write: if isAuthed() && request.auth.uid == uid;


    }

    // ── Boards collection ─────────────────────────────────────────────────
    match /boards/{boardId} {
      // resource.data is used here — no get() needed, no circular dependency
      allow read:   if isMemberOf(resource.data);
      allow create: if isAuthed()
                    && 'users' in request.resource.data
                    && 'admins' in request.resource.data.users
                    && request.auth.uid in request.resource.data.users.admins;
      allow update: if isAdminOf(resource.data)
                    // Allow an invited user to accept their own invitation:
                    // only the users.members / users.nonMembers fields may change,
                    // and only to add the caller's own UID as a member.
                    || (isAuthed()
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['users'])
                        && request.resource.data.users.diff(resource.data.users).affectedKeys().hasOnly(['members', 'nonMembers'])
                && canAcceptOwnInvite(resource.data, request.resource.data));
      allow delete: if isAdminOf(resource.data);

      // ── Tasks subcollection ─────────────────────────────────────────────
      match /tasks/{taskId} {
        allow read, write: if isBoardMember(boardId);
      }

      // ── Activity subcollection ──────────────────────────────────────────
      match /activity/{activityId} {
        allow read:   if isBoardMember(boardId);
        allow create: if isBoardMember(boardId);
        // No updates — preserve audit-trail integrity.
        // Only admins may delete (e.g. clear-logs feature).
        allow delete: if isBoardAdmin(boardId);
      }

      // ── Templates subcollection ─────────────────────────────────────────
      match /templates/{templateId} {
        allow read, write: if isBoardMember(boardId);
      }
    }

    // ── Invitations collection ────────────────────────────────────────────
    match /invitations/{invId} {
      allow create: if isAuthed()
                    && isBoardAdmin(request.resource.data.boardId);
      allow read:   if isAuthed() && (
                       isBoardAdmin(resource.data.boardId) ||
                       request.auth.token.email == resource.data.email
                    );
      allow update: if isAuthed() && (
                       isBoardAdmin(resource.data.boardId) ||
                       request.auth.token.email == resource.data.email
                    );
      allow delete: if isAuthed() && isBoardAdmin(resource.data.boardId);
    }
  }
}